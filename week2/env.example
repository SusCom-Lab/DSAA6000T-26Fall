# Copy this file to .env, then replace values as needed for your server.
COMPOSE_PROJECT_NAME=week2-llama
IMAGE_NAME=your-local-image-name:tag
MODEL_PATH=/absolute/path/to/your/Llama-3.1-8B-Instruct

# The router is the only service published on the host.
ROUTER_BIND_HOST=127.0.0.1
ROUTER_PORT=8080

# Shared internal port used by the router and both backends.
SERVICE_PORT=8000
CPU_THREADS=32

# Host GPU index as shown by nvidia-smi (0, 1, 2, ...).
# The wrapper resolves its live UUID and exposes only that GPU.
GPU_INDEX=0
